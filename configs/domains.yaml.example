# Conservative narrow-gate cues for the seven SocialPersona domains.
# Matching is case-insensitive. Hashtags may be written with or without '#'.
domains:
  - name: sports_outdoor
    seed_keywords: [sports, football, soccer, basketball, baseball, running, hiking, cycling, workout, fitness, outdoors]
    seed_hashtags: [sports, football, soccer, basketball, running, hiking, cycling, fitness, outdoors]

  - name: entertainment
    seed_keywords: [music, movie, film, television, concert, album, book, novel, anime, podcast, theater]
    seed_hashtags: [music, movies, film, books, anime, podcast, concert]

  - name: gaming
    seed_keywords: [video game, gaming, xbox, playstation, nintendo, steam game, esports, role-playing game]
    seed_hashtags: [gaming, videogames, xbox, playstation, nintendo, esports]

  - name: food_drink
    seed_keywords: [restaurant, cooking, recipe, coffee, tea, dessert, breakfast, lunch, dinner, cuisine]
    seed_hashtags: [food, cooking, recipe, coffee, dessert, breakfast, lunch, dinner]

  - name: travel_city_exploration
    seed_keywords: [travel, vacation, flight, hotel, sightseeing, museum, city walk, road trip, beach trip, cruise]
    seed_hashtags: [travel, vacation, sightseeing, citywalk, roadtrip, cruise]

  - name: photography_creation
    seed_keywords: [photography, photographer, camera, camera lens, portrait photo, photo editing, illustration, graphic design]
    seed_hashtags: [photography, photographer, camera, portrait, photoediting, illustration, design]

  - name: pets
    seed_keywords: [pet dog, pet cat, puppy, kitten, pet care, veterinarian, dog walk, animal shelter]
    seed_hashtags: [pets, dogs, cats, puppy, kitten, petcare]
